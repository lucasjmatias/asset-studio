{
  "name": "asset-studio",
  "version": "0.1.0",
  "description": "A non-destructive SVG pose and pixel-art export studio.",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/studio-core --target web --out-dir ../../src/lib/wasm --out-name studio_core",
    "dev": "pnpm build:wasm && vite dev",
    "build": "pnpm build:wasm && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "check": "pnpm build:wasm && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "canvaskit-wasm": "^0.41.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
